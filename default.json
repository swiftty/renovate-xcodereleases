{
  "customDatasources": {
    "xcode": {
      "format": "json",
      "transformTemplates": [
        "{ \"releases\": ( $dict := $reduce($, function($acc, $v) {( $key := $string($v.version) & ( $exists($v.info.release.beta) ? \"_beta_\" & $string($v.info.release.beta) : $exists($v.info.release.rc) ? \"_Release_Candidate_\" & $string($v.info.release.rc) : \"\" ); $date := $string($v.info.date.year) & \"-\" & $pad($string($v.info.date.month), -2, \"0\") & \"-\" & $pad($string($v.info.date.day), -2, \"0\") & \"T00:00Z\"; $merge([$acc, { $key: { \"version\": $key, \"isStable\": $v.info.release.release ?? false, \"releaseTimestamp\": $date, \"changelogUrl\": $v.info.release_note_url, \"sourceUrl\": $v.info.release_note_url } }]) )}, {}); $spread($dict).* ) } "
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["\\.github/.*\\.ya?ml"],
      "matchStrings": [
        "#\\s*renovate-xcodereleases:\\s*runs-on=\\s*macos-(?<runsOnVersion>[^\\s]+)[^\\n]*\\n.*?(?<currentValue>[0-9]+(?:\\.[0-9]+)*)"
      ],
      "registryUrlTemplate": "https://raw.githubusercontent.com/swiftty/InstalledXcodeVersions/refs/heads/main/releases/installed-xcode-versions-{{runsOnVersion}}.json",
      "datasourceTemplate": "custom.xcode",
      "versioningTemplate": "loose",
      "depNameTemplate": "apple/xcode"
    },
    {
      "customType": "regex",
      "fileMatch": ["\\.github/.*\\.ya?ml"],
      "matchStrings": [
        "#\\s*renovate-xcodereleases:\\s*runs-on=\\s*macos-(?<currentVersion>[^\\s]+)"
      ],
      "datasourceTemplate": "github-runners",
      "versioningTemplate": "loose"
    }
  ]
}
